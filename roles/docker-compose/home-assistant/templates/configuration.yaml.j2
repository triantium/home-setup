# Listenbrainz
sensor:
  - platform: rest
    name: listenbrainz
    scan_interval: 120
    resource: https://api.listenbrainz.org/1/user/triantium/listens?count=1
    json_attributes_path: "payload.listens[0].track_metadata"
    json_attributes:
      - "track_name"
      - "artist_name"
      - "release_name"
    value_template: '{% raw %}{{ value_json.payload.listens[0].listened_at|timestamp_utc }}{% endraw %}'
# Telegram
telegram_bot:
  - platform: polling
    api_key: "{{ telegram_token }}"
    allowed_chat_ids:
      - 320105306
notify:
  - platform: telegram
    name: "triantium"
    chat_id: 320105306
