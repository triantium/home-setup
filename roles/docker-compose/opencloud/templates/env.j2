OC_DOCKER_IMAGE=opencloudeu/opencloud-rolling
OC_DOCKER_TAG=9.0.0
OC_CONTAINER_UID_GID=1000:1000

OC_DOMAIN={{ opencloud_domain }}
INSECURE={{ opencloud_insecure | lower }}
DEMO_USERS={{ opencloud_demo_users | lower }}
INITIAL_ADMIN_PASSWORD=
LOG_LEVEL=info
LOG_PRETTY=false
DEFAULT_LANGUAGE={{ opencloud_default_language }}

OC_CONFIG_DIR={{ opencloud_oc_config_dir }}
OC_DATA_DIR={{ opencloud_oc_data_dir }}
OC_APPS_DIR={{ opencloud_apps_dir }}

LDAP_BIND_PASSWORD={{ opencloud_ldap_bind_password }}
LDAP_CERTS_DIR={{ opencloud_ldap_certs_dir }}
LDAP_DATA_DIR={{ opencloud_ldap_data_dir }}

IDP_DOMAIN={{ opencloud_idp_domain }}
IDP_ISSUER_URL={{ opencloud_idp_issuer_url }}
IDP_ACCOUNT_URL={{ opencloud_idp_account_url }}

{% if opencloud_smtp_enabled %}
SMTP_HOST={{ opencloud_smtp_host }}
SMTP_PORT={{ opencloud_smtp_port }}
SMTP_SENDER={{ opencloud_smtp_sender }}
SMTP_USERNAME={{ opencloud_smtp_username }}
SMTP_PASSWORD={{ opencloud_smtp_password }}
SMTP_AUTHENTICATION=login
SMTP_TRANSPORT_ENCRYPTION=ssltls
SMTP_INSECURE=false
{% else %}
SMTP_HOST=
SMTP_PORT=
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_TRANSPORT_ENCRYPTION=
SMTP_INSECURE=false
{% endif %}

START_ADDITIONAL_SERVICES=notifications
GRAPH_ASSIGN_DEFAULT_USER_ROLE=true
PROXY_ROLE_ASSIGNMENT_DRIVER=default
PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM=roles
OC_OIDC_CLIENT_ID=
GRAPH_USERNAME_MATCH=none
PROXY_AUTOPROVISION_CLAIM_GROUPS=groups
WEB_OIDC_SCOPE=openid profile email groups
OC_OIDC_CLIENT_SCOPES=openid profile email groups
